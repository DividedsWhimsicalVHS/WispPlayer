[Desktop Entry]
Type=Application
Name=Wisp Player
GenericName=Music Player
Comment=A featherweight, gapless music player
Exec=wisp
Icon=io.github.DividedsWhimsicalVHS.WispPlayer
Terminal=false
Categories=AudioVideo;Audio;Player;Music;
Keywords=music;audio;player;gapless;lyrics;flac;mp3;playlist;
StartupWMClass=io.github.DividedsWhimsicalVHS.WispPlayer
# The window adapts to a phone's width (the phone shells use this to list the app)
X-Purism-FormFactor=Workstation;Mobile;
