<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is drawn by the player itself; the theme only colors what shows before the first frame
         and the system bars around it (dark, like the player's own default theme). -->
    <color name="window">#0a0a0e</color>

    <style name="Theme.Wisp" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@color/window</item>
        <item name="android:navigationBarColor">@color/window</item>
    </style>
</resources>
