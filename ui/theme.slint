// Design tokens. Everything visual that is not layout comes from here. The values are written by
// the theme engine (src/themes.rs) whenever the theme, the accent or the artwork changes, so a
// theme restyles the whole app by changing these properties and nothing else. The defaults below
// are the Wisp dark theme, so a window shown before a theme was applied still looks right.

export global Theme {
    // -- settings
    /// The screen is touched, not pointed at: nothing waits for a hover, targets are bigger, a tap
    /// is enough where a mouse double-clicks. Set once at startup, by the platform.
    in-out property <bool> touch: false;
    /// 0 = compact, 1 = comfortable, 2 = spacious
    in-out property <int> density: 1;
    in-out property <bool> backdrop-on: true;

    // -- palette
    in-out property <color> accent: #fa2d48;
    /// Second accent: the end of gradient seek bars (equal to `accent` when there is none).
    in-out property <color> accent2: #fa2d48;
    in-out property <color> on-accent: #ffffff;
    /// The accent as the color of small text (the playing track, an artist's name): the accent
    /// itself when it reads well on the surfaces, else nudged toward the text color.
    in-out property <color> accent-text: #fa2d48;
    in-out property <color> bg: #0a0a0e;
    in-out property <color> bg2: #0a0a0e;
    in-out property <bool> bg-gradient: false;
    in-out property <color> sidebar: #00000046;
    in-out property <color> surface: #ffffff12;
    in-out property <color> surface-hi: #ffffff20;
    in-out property <color> bar: #1b1b22ea;
    in-out property <color> overlay: #26262ef5;
    in-out property <color> scrim: #0a0a0ebf;
    in-out property <color> text: #ffffff;
    in-out property <color> text-2: #ffffffb2;
    in-out property <color> text-3: #ffffff68;
    in-out property <color> line: #ffffff1a;
    in-out property <color> hover: #ffffff14;
    in-out property <color> press: #ffffff24;
    in-out property <color> track: #ffffff2e;
    in-out property <color> thumb: #ffffff66;
    in-out property <color> seg: #ffffff2e;
    in-out property <color> knob: #ffffff;
    in-out property <color> shadow: #00000066;
    in-out property <color> danger: #ff5c6c;
    in-out property <color> tint: #00000000;

    // -- style traits
    /// Corner rounding of cards, rows, buttons and inputs (1 = the default look).
    in-out property <float> rounding: 1;
    /// Roundness of play button, icon buttons, toggles and thumbs (1 = circle, 0 = square).
    in-out property <float> circle: 1;
    in-out property <length> border-w: 1px;
    in-out property <string> font: "";
    in-out property <string> title-font: "";
    in-out property <int> weight: 400;
    in-out property <float> glow: 0;
    in-out property <float> gloss: 0;
    in-out property <bool> bevel: false;
    in-out property <color> bevel-light: #ffffff;
    in-out property <color> bevel-dark: #808080;
    in-out property <float> neu: 0;
    in-out property <color> neu-light: #ffffff;
    in-out property <color> neu-dark: #a3b1c6;
    in-out property <float> wash: 1;
    in-out property <float> hit: 1;
    /// Seek/volume bar: 0 text color, 1 accent, 2 gradient from accent to accent2.
    in-out property <int> bar-style: 0;

    out property <length> row-h: density == 0 ? 40px : density == 1 ? 52px : 64px;
    out property <length> cover-radius: 10px * rounding;
}

